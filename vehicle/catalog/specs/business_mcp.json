    "car_prepare_ctrl"
  ],
  "operations": [
    {
      "device": "hvac",
      "tool": "ac_ctrl",
      "mcp_tool": "dispatch_vehicle_command",
      "downstream_tool": "ac_ctrl",
      "title": "空调控制",
      "category": "空调舒适",
      "description": "控制车内空调开关、温度、风量、模式、除霜、内外循环及预设模式",
      "aliases": ["空调", "开空调", "关空调", "调空调", "调温度", "设温度", "风量", "风速", "制冷", "制热", "除霜", "除雾", "内外循环", "极速制冷", "极速制热", "快速除味"],
      "utterances": ["打开空调调到24度", "空调温度调高2度", "把空调风量调大一档", "打开风挡除霜", "开启内循环", "关闭空调"],
      "anti_examples": ["空调开着吗", "现在车内多少度", "空调状态", "预约空调"],
      "mutually_exclusive": [
        ["temperature", "temperature_tune"],
        ["wind_level", "wind_level_tune"]
      ],
      "fields": [
        {
          "name": "power",
          "type": "string",
          "required": true,
          "enum": ["on", "off"],
          "enum_labels": { "on": ["打开", "开启"], "off": ["关闭"] },
          "question": "要打开还是关闭空调？",
          "extractor": {
            "kind": "enum_alias",
            "value_aliases": {
              "on": ["打开空调", "开空调", "开启空调", "空调开", "调高", "调低", "调到", "设成", "制冷", "制热", "除霜", "除雾", "内循环", "外循环", "打开", "开启"],
              "off": ["关闭空调", "关空调", "空调关", "关闭"]
            }
          }
        },
        {
          "name": "premode",
          "type": "string",
          "enum": ["1", "2", "3", "4", "5", "6", "7", "8"],
          "enum_labels": {
            "1": ["极速制冷"],
            "2": ["极速制热"],
            "3": ["快速除味"],
            "4": ["打开风挡除霜", "除霜", "除雾"],
            "5": ["关闭风挡除霜"],
            "6": ["关闭极速制冷"],
            "7": ["关闭极速制热"],
            "8": ["关闭快速除味"]
          }
        },
        { "name": "operate", "type": "string", "enum": ["auto", "manual"] },
        {
          "name": "temperature",
          "type": "string",
          "dynamic_bound": "temperature_c",
          "extractor": {
            "kind": "number",
            "unit_pattern": "(?:度|℃|°c|c)?",
            "min": 16,
            "max": 32,
            "allow_bare_number": true
          }
        },
        {
          "name": "temperature_tune",
          "type": "string",
          "extractor": {
            "kind": "relative_tune",
            "unit_pattern": "(?:度|℃|°c)?"
          }
        },
        {
          "name": "wind_level",
          "type": "string",
          "extractor": {
            "kind": "number",
            "unit_pattern": "(?:档|挡|级)",
            "min": 1,
            "max": 8
          }
        },
        {
          "name": "wind_level_tune",
          "type": "string",
          "extractor": {
            "kind": "relative_tune",
            "unit_pattern": "(?:档|挡|级)?"
          }
        },
        { "name": "mode", "type": "string", "enum": ["nohotcold", "hot", "cold"] },
        { "name": "windshield_switch", "type": "string", "enum": ["on", "off"] },
        { "name": "circle", "type": "string", "enum": ["in", "out"] }
      ],
      "guard": {
        "device_keywords": ["空调", "温度", "风量", "风速", "制冷", "制热", "冷风", "暖风", "除霜", "除雾", "循环", "除味"],
        "positive_verbs": ["开", "打开", "开启", "关", "关闭", "调", "设", "升", "降", "加大", "减小"],
        "relative_action_keywords": ["调高", "调低", "升高", "降低", "调大", "调小", "加大", "减小", "高一点", "低一点"]
      }
    },
