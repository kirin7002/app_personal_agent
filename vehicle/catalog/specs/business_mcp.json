              "rear_left": ["左后", "后排左", "二排左"],
              "rear_right": ["右后", "后排右", "二排右"],
              "all": ["全部", "所有座椅", "全车"]
            }
          }
        },
        {
          "name": "power",
          "type": "string",
          "enum": ["on", "off"],
          "extractor": {
            "kind": "enum_alias",
            "value_aliases": {
              "on": ["打开", "开启", "开"],
              "off": ["关闭", "关"]
            }
          }
        },
        {
          "name": "level",
          "type": "integer",
          "min": 1,
          "max": 3,
          "extractor": {
            "kind": "integer",
            "unit_pattern": "(?:档|挡|级)?",
            "min": 1,
            "max": 3,
            "allow_bare_number": true
          }
        }
      ],
      "guard": {
        "device_keywords": ["座椅加热", "座椅", "加热"],
        "positive_verbs": ["开", "打开", "开启", "关", "关闭", "调", "设"]
